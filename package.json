{
  "name": "nutrition-planner",
  "version": "1.0.0",
  "description": "Desktop nutrition tracking with USDA food data and AI coaching",
  "main": "./out/main/index.js",
  "author": "mikep",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:win": "npx @electron/rebuild -f -w better-sqlite3 && npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "db:download": "node scripts/download-usda.mjs",
    "db:import": "node scripts/import-usda.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "db:popularity": "node scripts/import-popularity.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.10.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.469.0",
    "openai": "^6.42.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "csv-parse": "^5.5.6",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.2",
    "electron-vite": "^3.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
