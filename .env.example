# Supabase project coordinates, compiled into the main bundle at build time.
#
# Neither of these is a secret. The anon key is a publishable identifier whose
# reach is bounded by the row-level security policies in supabase/migrations,
# and it is designed to ship inside client applications. Copy both from
# Supabase Dashboard → Project Settings → API.
#
# Leave unset for a from-source build: the app then reports AI as unconfigured
# and every other feature works normally.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------------------
# The following are NOT used by the desktop build and must never be set here.
# They belong to the Edge Function, and are set with:
#
#   npx supabase secrets set OPENAI_API_KEY=sk-...
#
# The provider key is the one credential in this system that is genuinely
# secret, which is exactly why it lives on the server and not in the installer.
# Optional function-side overrides: AI_MODEL, AI_DAILY_LIMIT, AI_MONTHLY_LIMIT,
# and OPENAI_BASE_URL (used by the local test harness to point at a fake server).
